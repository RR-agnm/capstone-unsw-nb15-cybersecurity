# ================================
# CIC-IoMT-2024 PARQUET → CSV
# ================================

# 1. Install required dependency
get_ipython().getoutput("pip install pyarrow -q")

# 2. Import libraries
import pandas as pd
import os

# 3. File paths from Kaggle input
train_path = "/kaggle/input/cic-iomt-2024/preprocessed_train_iomt.parquet"
test_path  = "/kaggle/input/cic-iomt-2024/preprocessed_test_iomt.parquet"

# 4. Load parquet files
print("Loading Train Dataset...")
train_df = pd.read_parquet(train_path)

print("Loading Test Dataset...")
test_df = pd.read_parquet(test_path)

# 5. Check dataset shapes
print("\nTrain Shape:", train_df.shape)
print("Test Shape :", test_df.shape)

# 6. Convert to CSV
print("\nConverting to CSV...")

train_df.to_csv("/kaggle/working/train_iomt.csv", index=False)
test_df.to_csv("/kaggle/working/test_iomt.csv", index=False)

print("\nConversion Completed!")

# 7. Verify saved files
print("\nSaved Files in Working Directory:")
print(os.listdir('/kaggle/working'))

